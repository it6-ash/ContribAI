# Copy to backend/.env . Everything here is optional: with an empty file the
# app runs in demo mode with deterministic heuristics and no network calls.

# SQLite by default. Point at postgres for a real deployment.
DATABASE_URL=sqlite:///./contribai.db

SESSION_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- LLM (Groq, OpenAI-compatible) -----------------------------------------
# Without a key the app falls back to deterministic heuristics everywhere.
# Nothing breaks; issue explanations and plans are rule-derived instead.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_EFFORT=medium

# --- GitHub ----------------------------------------------------------------
# OAuth app: callback URL must be {BACKEND_URL}/api/auth/github/callback
# Scope requested is read:user only. No repository write access.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Server-side PAT for issue discovery. Raises the anonymous 60 req/hr to 5000.
GITHUB_TOKEN=

# --- Ingest ----------------------------------------------------------------
INGEST_TOKEN=


MAX_CANDIDATE_ISSUES=150
